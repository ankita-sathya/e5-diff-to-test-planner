diff --git a/src/cluster/speedometer.cpp b/src/cluster/speedometer.cpp
index 1a2b3c4..5d6e7f8 100644
--- a/src/cluster/speedometer.cpp
+++ b/src/cluster/speedometer.cpp
@@ -42,7 +42,7 @@ void SpeedometerCluster::UpdateCANSignal(const CANFrame& frame) {
   if (frame.id == 0x1A4) {
-    uint16_t raw_speed = (frame.data[1] << 8) | frame.data[2];
+    uint16_t raw_speed = (frame.data[1] << 8) | frame.data[2];  // CAN signal 0x1A4 speed scaling adjusted for 0-240 km/h range
     float speed_kmh = (raw_speed * 240.0f) / 65535.0f;
     this->display_speed_kmh_ = speed_kmh;
     this->InvalidateDisplay();
@@ -50,6 +50,10 @@ void SpeedometerCluster::UpdateCANSignal(const CANFrame& frame) {
   }
 }
 
+void SpeedometerCluster::ApplySafetyLimits() {
+  if (display_speed_kmh_ > 240.0f) display_speed_kmh_ = 240.0f;
+  if (display_speed_kmh_ < 0.0f) display_speed_kmh_ = 0.0f;
+}
 
 }  // namespace cluster

